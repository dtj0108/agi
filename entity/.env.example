# Entity Environment Variables
# Copy this file to .env and fill in your values

# LLM API Key (choose one based on your provider)
# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI
# OPENAI_API_KEY=sk-xxx

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxx

# Ollama (no key needed for local)
# LLM_API_KEY=ollama

# General LLM key (used by docker-compose)
LLM_API_KEY=${ANTHROPIC_API_KEY}

# Optional: Node environment
NODE_ENV=production

# Optional: Logging level
LOG_LEVEL=info

# Optional: Local OAuth / OIDC
# ENTITY_AUTH_MODE=hybrid
# ENTITY_AUTH_OAUTH_ISSUER=https://auth.example.com
# ENTITY_AUTH_OAUTH_CLIENT_ID=your-client-id
# ENTITY_AUTH_OAUTH_SCOPES=openid profile email offline_access
# ENTITY_AUTH_OAUTH_FLOW=auto
# ENTITY_AUTH_STORAGE_MODE=keychain_fallback_file
# ENTITY_AUTH_STORAGE_FILE_PATH=./.entity/auth.json
# ENTITY_LLM_CREDENTIAL_SOURCE=auto
