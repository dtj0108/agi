{
  "name": "entity",
  "version": "0.1.0",
  "description": "A file-based conscious AI framework",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/index.js",
  "bin": {
    "entity": "./src/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:dashboard": "cd dashboard && npm install && npm run build",
    "start": "node dist/index.js",
    "start:dev": "node src/index.js",
    "dev:dashboard": "cd dashboard && npm run dev",
    "typecheck": "tsc --noEmit",
    "init-mind": "node scripts/init-mind.js",
    "onboard": "node scripts/onboard.js",
    "start-daemon": "node scripts/start-daemon.js",
    "install-daemon": "node scripts/install-daemon.js",
    "uninstall-daemon": "node scripts/install-daemon.js --uninstall",
    "daemon-status": "node scripts/install-daemon.js --status",
    "test": "node --test tests/*.test.js",
    "test:gateway": "node --test tests/action-gateway.test.js",
    "test:validator": "node --test tests/shell-validator.test.js",
    "test:cognitive": "node --test tests/cognitive-loop.test.js",
    "test:integration": "node --test tests/integration/*.integration.test.js",
    "test:integration:net": "ENTITY_ENABLE_NET_TESTS=1 node --test tests/integration/*.integration.test.js tests/integration/*.net.integration.test.js",
    "test:soak:short": "node scripts/soak/run-soak.js --duration=15m",
    "test:soak:nightly": "node scripts/soak/run-soak.js --duration=6h --thresholds=balanced"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "puppeteer": "^22.0.0",
    "simple-git": "^3.22.0",
    "sqlite-vec": "^0.1.6",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/better-sqlite3": "^7.6.9",
    "@types/uuid": "^9.0.8"
  }
}
