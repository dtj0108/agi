{
  "name": "entity",
  "version": "0.1.0",
  "description": "A file-based conscious AI framework",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "entity": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.src.json",
    "build:watch": "tsc -b tsconfig.src.json --watch",
    "build:dashboard": "cd dashboard && npm install && npm run build",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "dev:dashboard": "cd dashboard && npm run dev",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "init-mind": "tsx scripts/init-mind.ts",
    "onboard": "tsx scripts/onboard.ts",
    "start-daemon": "tsx scripts/start-daemon.ts",
    "install-daemon": "tsx scripts/install-daemon.ts",
    "uninstall-daemon": "tsx scripts/install-daemon.ts --uninstall",
    "daemon-status": "tsx scripts/install-daemon.ts --status",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:gateway": "node --import tsx --test tests/action-gateway.test.ts",
    "test:validator": "node --import tsx --test tests/shell-validator.test.ts",
    "test:cognitive": "node --import tsx --test tests/cognitive-loop.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.integration.test.ts",
    "test:integration:net": "ENTITY_ENABLE_NET_TESTS=1 node --import tsx --test tests/integration/*.integration.test.ts tests/integration/*.net.integration.test.ts",
    "test:soak:short": "tsx scripts/soak/run-soak.ts --duration=15m",
    "test:soak:nightly": "tsx scripts/soak/run-soak.ts --duration=6h --thresholds=balanced",
    "check:ts-migration": "node scripts/ci/check-ts-migration.mjs",
    "check:js-allowlist": "node scripts/ci/check-js-allowlist.mjs",
    "check:migration": "npm run check:ts-migration && npm run check:js-allowlist"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "acorn": "^8.16.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "puppeteer": "^22.0.0",
    "simple-git": "^3.33.0",
    "sqlite-vec": "^0.1.7",
    "uuid": "^9.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.37",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "ts-morph": "^27.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.4.0"
  }
}
